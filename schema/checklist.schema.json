{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/securitycipher/writeup-checklists/schema/checklist.schema.json",
  "title": "WriteupChecklistCard",
  "description": "One actionable checklist card derived from a public bug bounty writeup.",
  "type": "object",
  "required": [
    "id",
    "title",
    "source_url",
    "category",
    "quick_test",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,16}$",
      "description": "Stable fingerprint (hash of canonical source URL)."
    },
    "title": { "type": "string", "minLength": 8, "maxLength": 240 },
    "source_url": { "type": "string", "format": "uri" },
    "author": { "type": "string" },
    "publication_date": {
      "type": "string",
      "description": "ISO date YYYY-MM-DD when possible."
    },
    "category": {
      "type": "string",
      "description": "Folder slug under checklists/, e.g. broken-access-control"
    },
    "content_type": {
      "type": "string",
      "enum": ["vuln_writeup", "practical_guide"]
    },
    "steps_source": {
      "type": "string",
      "enum": ["extracted", "ai_inferred", "curated"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 12
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quick_test": {
      "type": "string",
      "description": "One-line test a hunter can run today."
    },
    "use_case": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" }
    },
    "commands": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
